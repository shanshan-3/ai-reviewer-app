{
  "expo": {
    "name": "RebyuIT",
    "slug": "RebyuIT",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo/splash-logo-white.png",
    "userInterfaceStyle": "light",
    "scheme": "ai-reviewer",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#36454F",
        "foregroundImage": "./assets/logo/index-icon-white.png"
      },
      "package": "com.anonymous.RebyuIT"
    },
    "web": {
      "favicon": "./assets/logo/index-icon-white.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sharing",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#36454F",
          "image": "./assets/logo/index-icon-white.png",
          "imageWidth": 10,
          "resizeMode": "contain"
        }
      ]
    ]
  }
}
